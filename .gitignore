# Secrets and local hosting configuration
.env
.env.*
!.env.example
**/.env
**/.env.*
**/server_config.ini
**/*secret*.local.php
**/*credentials*.local.php
*.key
*.pem

# Runtime data (preserve tracked Apache protections and indexes)
/Сайт/data/*
!/Сайт/data/.htaccess
!/Сайт/data/index.php
/Форум/storage/*
!/Форум/storage/.htaccess
!/Форум/storage/index.php
/Вики/storage/*
!/Вики/storage/.htaccess
!/Вики/storage/index.php
/Вики/assets/uploads/*
!/Вики/assets/uploads/.htaccess
!/Вики/assets/uploads/index.php

# Compiled server and generated state
*.amx
*.dll
*.so
*.sqlite
*.sqlite3
*.db
*.pid
*.log
*.tmp
*.bak
*.swp
*.zip
*.rar
*.7z
**/logs/
**/cache/
**/vendor/
**/node_modules/
__pycache__/
.pytest_cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
